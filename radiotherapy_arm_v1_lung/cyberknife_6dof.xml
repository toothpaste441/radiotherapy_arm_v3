
<mujoco model="CyberKnife_6DOF">

    <compiler angle="radian"
              coordinate="local"
              meshdir="assets"/>

    <option timestep="0.002"
            gravity="0 0 -9.81"
            integrator="implicitfast"/>

    <visual>
        <global offwidth="1920" offheight="1080"/>
        <headlight diffuse="0.8 0.8 0.8"
                   ambient="0.3 0.3 0.3"
                   specular="0.2 0.2 0.2"/>
    </visual>

    <asset>
        <mesh name="base"
              file="robot_assembly - robot_base_w-1.STL"
              scale="0.001 0.001 0.001"/>

        <mesh name="base_joint" file="robot_6dof/base_joint.STL" scale="0.001 0.001 0.001"/>
        <mesh name="link1" file="robot_6dof/link1.STL" scale="0.001 0.001 0.001"/>
        <mesh name="link2" file="robot_6dof/link2.STL" scale="0.001 0.001 0.001"/>
        <mesh name="wrist_yaw" file="robot_6dof/wrist_yaw.STL" scale="0.001 0.001 0.001"/>
        <mesh name="wrist_pitch" file="robot_6dof/wrist_pitch.STL" scale="0.001 0.001 0.001"/>
        <mesh name="wrist_roll" file="robot_6dof/wrist_roll.STL" scale="0.001 0.001 0.001"/>
        <mesh name="end_effector" file="robot_6dof/end_effector.STL" scale="0.001 0.001 0.001"/>
    </asset>

    <worldbody>

        <light pos="1 1 3" dir="-1 -1 -2"/>

        <body name="tumor_target" mocap="true" pos="0 0 0">
            <geom name="tumor_marker" type="sphere" size="0.025"
                  rgba="0.95 0.12 0.10 0.8"
                  contype="0" conaffinity="0"/>
        </body>

        <geom name="ground"
              type="plane"
              size="5 5 0.1"
              rgba="0.25 0.25 0.25 1"/>

        <body name="robot_base"
              pos="0 0 -0.742635"
              quat="0.7071068 0.7071068 0 0">

            <geom name="base_visual"
                  type="mesh" mesh="base"
                  contype="0" conaffinity="0"/>

            <!-- J1 -->
            <body name="joint1_body"
                  pos="0.828437 0.842635 1.432980">

                <joint name="joint1" type="hinge"
                       axis="0 1 0"
                       range="-1.5708 1.5708"
                       limited="true" damping="5"/>

                <geom type="mesh" mesh="base_joint"
                      contype="0" conaffinity="0"/>

                <!-- J2 -->
                <body name="joint2_body"
                      pos="-0.157479 0.220000 -0.001101">

                    <joint name="joint2" type="hinge"
                           axis="1 0 0"
                           range="-1.5708 1.5708"
                           limited="true" damping="5"/>

                    <geom type="mesh" mesh="link1"
                          contype="0" conaffinity="0"/>

                    <!-- J3 -->
                    <body name="joint3_body"
                          pos="0.114677 0.462809 0.197913">

                        <joint name="joint3" type="hinge"
                               axis="1 0 0"
                               range="-2.0944 2.0944"
                               limited="true" damping="5"/>

                        <geom type="mesh" mesh="link2"
                              contype="0" conaffinity="0"/>

                        <!-- J4 -->
                        <body name="joint4_body"
                              pos="0.059083 0.168351 0.560350">

                            <joint name="joint4" type="hinge" armature="0.01"
                                   axis="-0.001567 0.287779 0.957695"
                                   range="-3.14159 3.14159"
                                   limited="true" damping="2"/>

                            <geom type="mesh" mesh="wrist_roll"
                                  pos="0.005163 -0.004829 0.016037"
                                  contype="0" conaffinity="0"/>

                            <!-- J5 -->
                            <body name="joint5_body"
                                  pos="0 0 0">

                                <joint name="joint5" type="hinge" armature="0.02"
                                       axis="-0.758631 0.623616 -0.188633"
                                       range="-1.5708 1.5708"
                                       limited="true" damping="2"/>

                                <geom type="mesh" mesh="wrist_pitch"
                                      pos="-0.004733 0.005524 0.037297"
                                      contype="0" conaffinity="0"/>

                                <geom type="mesh" mesh="wrist_yaw"
                                      pos="-0.017462 -0.021140 0.000340"
                                      contype="0" conaffinity="0"/>

                                <!-- J6 -->
                                <body name="joint6_body"
                                      pos="0.002742 0.019517 0.053494">

                                    <joint name="joint6" type="hinge" armature="0.02"
                                           axis="-0.639504 -0.768096 0.032608"
                                           range="-3.14159 3.14159"
                                           limited="true" damping="1"/>

                                    <geom name="tool_tip" type="mesh" mesh="end_effector"
                                          pos="0.002421 -0.024346 -0.037456"
                                          contype="0" conaffinity="0"/>

                                </body>
                            </body>
                        </body>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <motor name="motor1" joint="joint1" ctrlrange="-80 80"/>
        <motor name="motor2" joint="joint2" ctrlrange="-80 80"/>
        <motor name="motor3" joint="joint3" ctrlrange="-60 60"/>
        <motor name="motor4" joint="joint4" ctrlrange="-25 25"/>
        <motor name="motor5" joint="joint5" ctrlrange="-20 20"/>
        <motor name="motor6" joint="joint6" ctrlrange="-15 15"/>
    </actuator>
</mujoco>
